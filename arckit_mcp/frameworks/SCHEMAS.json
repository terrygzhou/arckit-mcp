{
  "compliance-evidence.json": {
    "$id": "https://arckit.org/schemas/architecture/compliance-evidence.json",
    "$schema": "http://json-schema.org/draft-07/schema#",
    "additionalProperties": false,
    "description": "Standardized per-sprint compliance evidence format: regulatory control status with verification artifacts, scan summary (SAST, secrets, dependencies, compliance), and next-sprint security goals. Shared between /arckit:agile-security and /arckit:agile-governance; feeds governance-report.yaml compliance monitoring. Structure source: templates/agile-security-template.md \u00a7Pillar 3 + templates/agile-governance-template.md \u00a74.",
    "properties": {
      "controls": {
        "items": {
          "additionalProperties": false,
          "properties": {
            "artifact": {
              "type": "string"
            },
            "control": {
              "minLength": 1,
              "type": "string"
            },
            "pending_items": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "status": {
              "enum": [
                "pass",
                "gap",
                "pending"
              ],
              "type": "string"
            },
            "verification": {
              "type": "string"
            },
            "verified_at": {
              "type": "string"
            }
          },
          "required": [
            "control",
            "status"
          ],
          "type": "object"
        },
        "minItems": 1,
        "type": "array"
      },
      "generated_at": {
        "type": "string"
      },
      "jurisdiction": {
        "enum": [
          "AU",
          "EU",
          "APAC",
          "US",
          "multi"
        ],
        "type": "string"
      },
      "next_sprint_goals": {
        "items": {
          "type": "string"
        },
        "type": "array"
      },
      "scan_summary": {
        "additionalProperties": false,
        "properties": {
          "compliance": {
            "additionalProperties": false,
            "properties": {
              "controls_checked": {
                "minimum": 0,
                "type": "integer"
              },
              "controls_gapped": {
                "minimum": 0,
                "type": "integer"
              },
              "controls_passed": {
                "minimum": 0,
                "type": "integer"
              },
              "status": {
                "type": "string"
              },
              "tool": {
                "type": "string"
              }
            },
            "required": [
              "status",
              "tool"
            ],
            "type": "object"
          },
          "dependencies": {
            "additionalProperties": false,
            "properties": {
              "critical_findings": {
                "minimum": 0,
                "type": "integer"
              },
              "high_findings": {
                "minimum": 0,
                "type": "integer"
              },
              "medium_findings": {
                "minimum": 0,
                "type": "integer"
              },
              "status": {
                "type": "string"
              },
              "tool": {
                "type": "string"
              }
            },
            "required": [
              "status",
              "tool"
            ],
            "type": "object"
          },
          "sast": {
            "additionalProperties": false,
            "properties": {
              "critical_findings": {
                "minimum": 0,
                "type": "integer"
              },
              "high_findings": {
                "minimum": 0,
                "type": "integer"
              },
              "status": {
                "type": "string"
              },
              "tool": {
                "type": "string"
              }
            },
            "required": [
              "status",
              "tool"
            ],
            "type": "object"
          },
          "secrets": {
            "additionalProperties": false,
            "properties": {
              "findings": {
                "minimum": 0,
                "type": "integer"
              },
              "status": {
                "type": "string"
              },
              "tool": {
                "type": "string"
              }
            },
            "required": [
              "status",
              "tool"
            ],
            "type": "object"
          }
        },
        "type": "object"
      },
      "sprint": {
        "minimum": 1,
        "type": "integer"
      }
    },
    "required": [
      "sprint",
      "controls"
    ],
    "title": "ArcKit OAA \u2014 Sprint Compliance Evidence (compliance-evidence-sprint-N.yaml)",
    "type": "object"
  },
  "strategy-canvas.json": {
    "$id": "https://arckit.org/schemas/architecture/strategy-canvas.json",
    "$schema": "http://json-schema.org/draft-07/schema#",
    "additionalProperties": false,
    "description": "Dual-transformation canvas: digital-technology + agile-organizational dimensions, axiom-traceable design principles, resilience mapping, and transformation wave plan. O-AA specific. Structure source: templates/agile-strategy-template.md (the 'agile-strategy-canvas.yaml' schema referenced by that template is this file).",
    "properties": {
      "cultural_agility": {
        "additionalProperties": false,
        "properties": {
          "change_initiatives": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "current_culture": {
            "type": "string"
          },
          "success_indicators": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "target_culture": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "design_principles": {
        "items": {
          "additionalProperties": false,
          "properties": {
            "axiom": {
              "minLength": 1,
              "type": "string"
            },
            "exceptions": {
              "type": "string"
            },
            "implications": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "principle": {
              "minLength": 1,
              "type": "string"
            },
            "rationale": {
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "principle",
            "axiom",
            "rationale"
          ],
          "type": "object"
        },
        "minItems": 1,
        "type": "array"
      },
      "operating_model": {
        "additionalProperties": false,
        "properties": {
          "capability_gaps": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "current_operating_model": {
            "type": "string"
          },
          "platform_strategy": {
            "type": "string"
          },
          "target_operating_model": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "organizational_agility": {
        "additionalProperties": false,
        "properties": {
          "current_state": {
            "type": "string"
          },
          "decision_framework": {
            "additionalProperties": false,
            "properties": {
              "executive_level": {
                "type": "string"
              },
              "guild_level": {
                "type": "string"
              },
              "team_level": {
                "type": "string"
              }
            },
            "type": "object"
          },
          "governance_model": {
            "type": "string"
          },
          "target_state": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "product": {
        "additionalProperties": false,
        "properties": {
          "current_product_model": {
            "type": "string"
          },
          "product_outcomes": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "target_product_model": {
            "type": "string"
          },
          "value_streams": {
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "type": "object"
      },
      "resilience_mapping": {
        "items": {
          "additionalProperties": false,
          "properties": {
            "impact": {
              "type": "string"
            },
            "mitigation": {
              "type": "string"
            },
            "recovery_target": {
              "additionalProperties": false,
              "properties": {
                "rpo": {
                  "type": "string"
                },
                "rto": {
                  "type": "string"
                }
              },
              "type": "object"
            },
            "resilience_domain": {
              "enum": [
                "technical",
                "organizational",
                "operational",
                "regulatory"
              ],
              "type": "string"
            },
            "threat": {
              "type": "string"
            },
            "transformation_dimension": {
              "enum": [
                "digital_technology",
                "agile_organizational",
                "digital_operating_model",
                "dual"
              ],
              "type": "string"
            }
          },
          "required": [
            "resilience_domain",
            "threat",
            "impact",
            "mitigation"
          ],
          "type": "object"
        },
        "type": "array"
      },
      "team_agility": {
        "additionalProperties": false,
        "properties": {
          "agile_practices": {
            "type": "string"
          },
          "current_team_model": {
            "type": "string"
          },
          "flow_metrics": {
            "additionalProperties": false,
            "properties": {
              "cycle_time_target": {
                "type": "string"
              },
              "lead_time_target": {
                "type": "string"
              },
              "wip_limit": {
                "type": "string"
              }
            },
            "type": "object"
          },
          "target_team_model": {
            "type": "string"
          },
          "team_composition": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "technology": {
        "additionalProperties": false,
        "properties": {
          "current_state": {
            "type": "string"
          },
          "enabling_technologies": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "migration_approach": {
            "type": "string"
          },
          "target_state": {
            "type": "string"
          },
          "technology_risks": {
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "type": "object"
      },
      "transformation_waves": {
        "items": {
          "additionalProperties": false,
          "properties": {
            "agile_activities": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "digital_activities": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "duration": {
              "minLength": 1,
              "type": "string"
            },
            "governance_gates": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "resilience_milestones": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "wave": {
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "wave",
            "duration"
          ],
          "type": "object"
        },
        "minItems": 1,
        "type": "array"
      }
    },
    "required": [
      "design_principles",
      "transformation_waves"
    ],
    "title": "ArcKit OAA \u2014 Agile Strategy Canvas (strategy-canvas.yaml)",
    "type": "object"
  }
}
